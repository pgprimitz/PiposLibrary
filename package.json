{
  "name": "tup-arcade-ui",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "Librería de componentes UI estilo arcade retro (TUP) — cards, botones, inputs, navbar, breadcrumb, footer, tema claro/oscuro e íconos pixel-art.",
  "main": "./dist/tup-arcade-ui.cjs",
  "module": "./dist/tup-arcade-ui.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/tup-arcade-ui.js",
      "require": "./dist/tup-arcade-ui.cjs"
    },
    "./style.css": "./dist/tup-arcade-ui.css",
    "./theme.css": "./src/theme/theme.css",
    "./assets/*": "./src/assets/*"
  },
  "files": [
    "dist",
    "src/assets",
    "src/theme/theme.css"
  ],
  "scripts": {
    "dev": "vite",
    "build:watch": "vite build --watch",
    "build": "vite build",
    "build:site": "vite build --config vite.config.site.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "lucide-react": "^1.43.0",
    "nes.css": "^2.2.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^4.5.4"
  }
}
